{
  "buildCommand": "pnpm install && pnpm --filter shared build && pnpm --filter backend build && pnpm --filter frontend build",
  "outputDirectory": "apps/frontend/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}